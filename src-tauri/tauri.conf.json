{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnOffScreens",
  "version": "2.1.0",
  "identifier": "io.github.onoffscreens.onoffscreens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OnOffScreens — Perfiles de monitores",
        "width": 1080,
        "height": 780,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0b0f19"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Perfiles de monitores para KDE Plasma",
    "longDescription": "OnOffScreens enciende y apaga monitores por perfiles desde una ventana moderna o desde el icono de la bandeja del sistema. Detección automática de pantallas y perfiles estables por EDID.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
