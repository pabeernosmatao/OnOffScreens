#  Salidas de texto
# --------------------------------------------------------------------------
def cmd_status(perfiles, mapa):
    info = outputs()
    print(t("st_title"))
    for num, salida in mapa.items():
        o = info.get(salida)
        if not o:
            continue
        w, h = logical_size(o)
        estado = t("st_on") if o.get("enabled") else t("st_off")
        print(f"  {num}. {salida:<12} {estado:<10} {w}x{h}")
    actual = perfil_actual(perfiles, mapa)
    print("\n" + t("st_current"), actual or t("st_custom"))


def cmd_list(perfiles, mapa):
    actual = perfil_actual(perfiles, mapa)
    for i, (nombre, objetivos) in enumerate(perfiles, 1):
        marca = "●" if nombre == actual else " "
        print(f"{marca} {i}. {nombre}   [{', '.join(objetivos)}]")


def cmd_map(mapa):
    info = outputs()
    uuids = uuid_map()
    print(
        f"{t('col_num'):<8}{t('col_out'):<14}{'UUID':<10}"
        f"{t('col_size'):<12}{t('col_state')}"
    )
    for num, salida in mapa.items():
        o = info.get(salida, {})
        w, h = logical_size(o) if o else (0, 0)
        uid = (uuids.get(salida) or "")[:8]
        estado = t("st_on") if o.get("enabled") else t("st_off")
        print(f"  {num:<6}{salida:<14}{uid:<10}{w}x{h:<9}{estado}")


def aviso_numeracion():
    info = outputs()
    conectadas = [n for n, o in info.items() if o.get("connected", True)]
    encendidas = [n for n in conectadas if info[n].get("enabled")]
    if len(encendidas) < len(conectadas):
        print(t("warn_off"), file=sys.stderr)


def cmd_menu(perfiles, mapa):
    if not shutil.which("kdialog"):
        sys.exit("kdialog no está instalado.")
    items = []
    for i, (nombre, _) in enumerate(perfiles, 1):
        items += [str(i), nombre]
    sel = subprocess.run(
        ["kdialog", "--title", t("menu_title"), "--menu", t("menu_pick"), *items],
        capture_output=True,
        text=True,
    ).stdout.strip()
    if sel.isdigit() and 1 <= int(sel) <= len(perfiles):
        nombre, objetivos = perfiles[int(sel) - 1]
        apply_profile(objetivos)
        notify(t("notify_applied", name=nombre))


def notify(msg):
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-a", APP, "-i", ICON, "pantallas", msg], check=False
        )


# --------------------------------------------------------------------------
#  Bandeja del sistema (AppIndicator / GTK3)
# --------------------------------------------------------------------------
def cmd_tray():
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("AppIndicator3", "0.1")
        from gi.repository import AppIndicator3, Gio, GLib, Gtk
    except (ImportError, ValueError):
        sys.exit("Faltan librerías de bandeja: python-gobject y libappindicator.")

    ind = AppIndicator3.Indicator.new(
        ICON, ICON, AppIndicator3.IndicatorCategory.APPLICATION_STATUS
    )
    ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
    if (ICONOS / f"{ICON}.png").exists():
        ind.set_icon_theme_path(str(ICONOS))

    st = {"items": {}, "updating": False, "reload_id": None}

    def refresh():
        try:
            perfiles = load_profiles()
            mapa = refresh_map()
            cur = perfil_actual(perfiles, mapa)
        except SystemExit:
            return
        st["updating"] = True
        for nombre, item in st["items"].items():
            item.set_active(nombre == cur)
        st["updating"] = False
        ind.set_title(f"{t('tray_tip')} — " + ", ".join(enabled_outputs()))

    def on_toggle(nombre, objetivos):
        def cb(item):
            if st["updating"] or not item.get_active():
                return
            apply_profile(objetivos)
            refresh()
            notify(t("notify_applied", name=nombre))

        return cb

    def launch(cmd):
        subprocess.Popen(cmd, start_new_session=True)
        GLib.timeout_add_seconds(2, lambda: (refresh(), False)[1])

    def ver_mapa():
        try:
            mapa = refresh_map()
            info = outputs()
            uuids = uuid_map()
            lineas = []
            for num, salida in mapa.items():
                o = info.get(salida, {})
                w, h = logical_size(o) if o else (0, 0)
                est = t("st_on") if o.get("enabled") else t("st_off")
                lineas.append(
                    f"{num}.  {salida:<12} {w}x{h}  {est}   id {uuids.get(salida, '')[:8]}"
                )
            subprocess.Popen(
                ["kdialog", "--title", t("dlg_map_title"), "--textbox",
                 "\n".join(lineas)],
                start_new_session=True,
            )
        except SystemExit:
            pass

    def build():
        menu = Gtk.Menu()
        st["items"] = {}
        primero = None
        for nombre, objetivos in load_profiles():
            item = Gtk.RadioMenuItem(label=nombre, group=primero)
            primero = primero or item
            item.connect("toggled", on_toggle(nombre, objetivos))
            menu.append(item)
            st["items"][nombre] = item

        menu.append(Gtk.SeparatorMenuItem())

        i_mapa = Gtk.MenuItem(label=t("tray_map_label"))
        i_mapa.connect("activate", lambda _: ver_mapa())
        menu.append(i_mapa)

        i_menu = Gtk.MenuItem(label=t("tray_pick"))
        i_menu.connect("activate", lambda _: launch([sys.executable, __file__, "menu"]))
        menu.append(i_menu)

        i_edit = Gtk.MenuItem(label=t("tray_edit"))
        i_edit.connect(
            "activate",
            lambda _: launch([shutil.which("kate") or "xdg-open", str(CONFIG)]),
        )
        menu.append(i_edit)

        i_kcm = Gtk.MenuItem(label=t("tray_kcm"))
        i_kcm.connect("activate", lambda _: launch(["kcmshell6", "kcm_kscreen"]))
        menu.append(i_kcm)

        menu.append(Gtk.SeparatorMenuItem())

        i_salir = Gtk.MenuItem(label=t("tray_quit"))
        i_salir.connect("activate", lambda _: Gtk.main_quit())
        menu.append(i_salir)

        menu.show_all()
        ind.set_menu(menu)
        refresh()
        return menu

    def reload(*_):
        if st["reload_id"]:
            GLib.source_remove(st["reload_id"])
        st["reload_id"] = GLib.timeout_add(400, do_reload)
        return True

    def do_reload():
        st["reload_id"] = None
        build()
        notify(t("notify_reload"))
        return False

    def on_dir_changed(_mon, changed, other, _event):
        nombres = {f.get_basename() for f in (changed, other) if f}
        if CONFIG.name in nombres:
            reload()

    monitor = Gio.File.new_for_path(str(CONFIG.parent)).monitor_directory(
        Gio.FileMonitorFlags.NONE, None
    )
    monitor.connect("changed", on_dir_changed)

    build()
    GLib.timeout_add_seconds(10, lambda: (refresh(), True)[1])
    Gtk.main()


# --------------------------------------------------------------------------
#  main
# --------------------------------------------------------------------------
def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    mapa = refresh_map()
    perfiles = load_profiles()

    if cmd in ("status", "estado"):
        cmd_status(perfiles, mapa)
    elif cmd in ("list", "ls"):
        cmd_list(perfiles, mapa)
    elif cmd in ("mapa", "map"):
        cmd_map(mapa)
    elif cmd in ("apply", "aplicar"):
        if len(args) < 2:
            sys.exit(t("err_usage"))
        buscado = args[1].strip().lower()
        elegido = None
        if buscado.isdigit() and 1 <= int(buscado) <= len(perfiles):
            elegido = perfiles[int(buscado) - 1]
        if not elegido:
            exactos = [p for p in perfiles if p[0].lower() == buscado]
            elegido = exactos[0] if len(exactos) == 1 else None
        if not elegido:
            parciales = [p for p in perfiles if buscado in p[0].lower()]
            elegido = parciales[0] if len(parciales) == 1 else None
        if not elegido:
            sys.exit(t("err_notfound"))
        apply_profile(elegido[1])
        notify(t("notify_applied", name=elegido[0]))
    elif cmd == "menu":
        cmd_menu(perfiles, mapa)
    elif cmd == "tray":
        cmd_tray()
    elif cmd == "init":
        write_default_config(mapa)
        print(t("msg_created", path=CONFIG))
        cmd_map(mapa)
        aviso_numeracion()
    elif cmd in ("reasignar", "reassign"):
        refresh_map(rebuild=True)
        print(t("msg_reassigned"))
        cmd_map(refresh_map())
        aviso_numeracion()
    elif cmd in ("edit", "editar"):
        subprocess.Popen([shutil.which("kate") or "xdg-open", str(CONFIG)])
    elif cmd in ("help", "-h", "--help"):
        print(t("help_short"))
    else:
        print(t("help_short"))


if __name__ == "__main__":
    main()
