def t(clave, **datos):
    textos = TEXTOS.get(IDIOMA) or TEXTOS["en"]
    plantilla = textos.get(clave, clave)
    return plantilla.format(**datos) if datos else plantilla



# --------------------------------------------------------------------------
#  kscreen-doctor
# --------------------------------------------------------------------------
def kscreen_json():
    try:
        out = subprocess.run(
            ["kscreen-doctor", "-j"], capture_output=True, text=True, check=True
        ).stdout
        return json.loads(out)
    except FileNotFoundError:
        sys.exit(t("err_kscreen"))
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        sys.exit(t("err_kscreen_read", e=e))


def outputs():
    """dict nombre_salida -> datos (sin Writeback ni duplicados raros)"""
    info = {}
    for o in kscreen_json()["outputs"]:
        name = o.get("name", "")
        if not name or name.startswith("Writeback"):
            continue
        info[name] = o
    return info


def uuid_map():
    """nombre_salida -> UUID estable derivado del EDID (de kscreen-doctor -o)"""
    try:
        txt = subprocess.run(
            ["kscreen-doctor", "-o"], capture_output=True, text=True, check=True
        ).stdout
    except (FileNotFoundError, subprocess.CalledProcessError):
        return {}
    txt = re.sub(r"\x1b\[[0-9;]*m", "", txt)
    res = {}
    for line in txt.splitlines():
        m = re.match(r"^Output:\s*\d+\s+(\S+)\s+([0-9a-fA-F-]{16,})", line)
        if m:
            res[m.group(1)] = m.group(2)
    return res


def logical_size(o):
    w = o["size"]["width"]
    h = o["size"]["height"]
    s = o.get("scale") or 1
    return round(w / s), round(h / s)


def enabled_outputs():
    return [n for n, o in outputs().items() if o.get("enabled")]


# --------------------------------------------------------------------------
#  Mapa estable de pantallas (número -> salida)
# --------------------------------------------------------------------------
def load_state():
    try:
        data = json.loads(STATE.read_text(encoding="utf-8"))
        if isinstance(data.get("screens"), dict):
            return data
    except (OSError, json.JSONDecodeError):
        pass
    return {"version": 1, "screens": {}}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")


def orden_por_posicion(nombres, info):
    """
    Ordena las pantallas para numerarlas: primero la fila principal (la que
    tiene más pantallas), de izquierda a derecha, y después el resto de filas
    de arriba abajo. Así, en una disposición 3 abajo + 1 arriba, la de arriba
    es el último número.
    """
    filas = {}
    for n in nombres:
        filas.setdefault(info[n]["pos"]["y"], []).append(n)

    def ancho(fila):
        return sum(logical_size(info[n])[0] for n in fila)

    def clave(par):
        _, fila = par
        prioridad = min(info[n].get("priority", 99) for n in fila)
        return (len(fila), ancho(fila), -prioridad)

    principal = max(filas.items(), key=clave)[0]

    orden = []
    for n in sorted(filas[principal], key=lambda n: (info[n]["pos"]["x"], n)):
        orden.append(n)
    for y in sorted(filas):
        if y == principal:
            continue
        for n in sorted(filas[y], key=lambda n: (info[n]["pos"]["x"], n)):
            orden.append(n)
    return orden


def refresh_map(rebuild=False):
    """devuelve {numero: salida}; crea o rehace el mapa estable"""
    info = outputs()
    uuids = uuid_map()
    conectadas = [n for n, o in info.items() if o.get("connected", True)]

    state = {"version": 1, "screens": {}} if rebuild else load_state()
    pantallas = state["screens"]

    # el nombre de la salida puede cambiar (otro puerto): se actualiza
    for uuid, datos in pantallas.items():
        for n in conectadas:
            if uuids.get(n) == uuid:
                datos["name"] = n

    conocidas = {
        uuids[n]: pantallas[uuids[n]]
        for n in conectadas
        if uuids.get(n) in pantallas
    }

    nuevas = [n for n in conectadas if uuids.get(n) and uuids[n] not in pantallas]
    if nuevas:
        usados = {d["num"] for d in pantallas.values()}
        libre = 1
        for n in orden_por_posicion(nuevas, info):
            while libre in usados:
                libre += 1
            o = info[n]
            w, h = logical_size(o)
            pantallas[uuids[n]] = {
                "num": libre,
                "name": n,
                "x": o["pos"]["x"],
                "y": o["pos"]["y"],
                "w": w,
                "h": h,
            }
            usados.add(libre)

    save_state(state)

    mapa = {}
    for uuid, d in pantallas.items():
        if uuid in {uuids.get(n) for n in conectadas}:
            mapa[d["num"]] = d["name"]
    return dict(sorted(mapa.items()))


def resolver(items, mapa, info):
    """resuelve números y nombres de salida a nombres reales"""
    res = []
    for it in items:
        if it.isdigit() and int(it) in mapa:
            res.append(mapa[int(it)])
        elif it in info:
            res.append(it)
        elif it.isdigit():
            print(t("warn_screen_num", n=it), file=sys.stderr)
    return res


# --------------------------------------------------------------------------
#  Colocación sin huecos
# --------------------------------------------------------------------------
def plan_layout(targets, state, info):
    """
    Coloca las pantallas objetivo conservando su disposición original
    (filas arriba/abajo) pero sin huecos. Devuelve {salida: (x, y)}.
    """
    por_uuid = {d["name"]: d for d in state["screens"].values()}

    filas = {}
    for n in targets:
        d = por_uuid.get(n)
        if d:
            x, y, w, h = d["x"], d["y"], d["w"], d["h"]
        else:
            o = info[n]
            x, y = o["pos"]["x"], o["pos"]["y"]
            w, h = logical_size(o)
        filas.setdefault(y, []).append((x, w, h, n))

    pos = {}
    alto_total = 0
    fila_y = []
    for y in sorted(filas):
        fila = sorted(filas[y], key=lambda t: t[0])
        alto = max(f[2] for f in fila)
        ancho = sum(f[1] for f in fila)
        fila_y.append((fila, alto, ancho))
        alto_total += alto

    ancho_max = max((a for _, _, a in fila_y), default=0)
    cursor_y = 0
    for fila, alto, ancho in fila_y:
        x = (ancho_max - ancho) // 2  # filas más estrechas, centradas
        for _, w, _, n in fila:
            pos[n] = (x, cursor_y)
            x += w
        cursor_y += alto
    return pos


def apply_profile(targets):
    info = outputs()
    conectadas = [n for n, o in info.items() if o.get("connected", True)]
    state = load_state()

    targets = [t for t in targets if t in conectadas]
    if not targets:
        sys.exit(t("err_profile_empty"))

    pos = plan_layout(targets, state, info)

    args = []
    for name in conectadas:
        if name not in targets:
            args.append(f"output.{name}.disable")
    for name, (x, y) in pos.items():
        args += [f"output.{name}.position.{x},{y}", f"output.{name}.enable"]

    res = subprocess.run(["kscreen-doctor", *args], capture_output=True, text=True)
    if res.returncode != 0:
        sys.exit(t("err_apply", out=f"{res.stdout}{res.stderr}"))

    for _ in range(30):
        if set(enabled_outputs()) == set(targets):
            break
        time.sleep(0.2)
    return targets


# --------------------------------------------------------------------------
#  Perfiles
# --------------------------------------------------------------------------
def write_default_config(mapa):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    lineas = [f"{t('cfg_header1')}\n{t('cfg_header2')}\n{t('cfg_header3')}\n#\n"]
    todos = ",".join(str(n) for n in sorted(mapa))
    lineas.append(f"{t('prof_all'):<21} = {todos}\n")
    for num, salida in sorted(mapa.items()):
        nombre = t("prof_only", num=num, out=salida)
        lineas.append(f"{nombre:<21} = {num}\n")
    CONFIG.write_text("".join(lineas), encoding="utf-8")


def load_profiles():
    mapa = refresh_map()
    info = outputs()

    if not CONFIG.exists():
        write_default_config(mapa)

    perfiles = []
    for raw in CONFIG.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        nombre, valor = line.split("=", 1)
        items = [i.strip() for i in valor.replace(";", ",").split(",") if i.strip()]
        objetivos = resolver(items, mapa, info)
        if nombre.strip() and objetivos:
            perfiles.append((nombre.strip(), objetivos))
    return perfiles


def perfil_actual(perfiles, mapa):
    activas = set(enabled_outputs())
    for nombre, objetivos in perfiles:
        if set(objetivos) == activas:
            return nombre
    return None


