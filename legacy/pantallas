def idioma_sistema():
    for var in ("PANTALLAS_IDIOMA", "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        valor = os.environ.get(var)
        if not valor:
            continue
        codigo = valor.split(":")[0].split(".")[0].split("_")[0].split("-")[0].lower()
        if len(codigo) == 2 and codigo.isalpha():
            return codigo
    return "es"


